# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres (Neon/Supabase free-tier connection string)
DATABASE_URL=postgresql://user:password@host:5432/chess_rag

# LLM provider (primary)
ANTHROPIC_API_KEY=sk-ant-...

# Used only for embeddings (Anthropic has no first-party embedding model)
OPENAI_API_KEY=sk-...

# Path to local Stockfish binary
STOCKFISH_PATH=/usr/local/bin/stockfish

# Model selection
CLAUDE_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
