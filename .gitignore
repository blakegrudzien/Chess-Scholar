node_modules/
dist/

# data — raw PGN dumps, ChessBase annotation exports, and any
# personally-owned copyrighted book text never commit these; keep
# public-domain-only sources if you want data in the repo
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/annotations/*
!data/annotations/.gitkeep

