# secrets
.env
.streamlit/secrets.toml

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# node (vendored into src/ui/board_component -- jquery/chessboard.js
# themselves are committed as static assets, not installed via npm, but
